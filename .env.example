# TRUSTFORGE Environment Configuration
# Copy this file to .env (or .env.local) to configure production credentials.

# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
# Leave empty if testing in offline/browser persistence mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application Base URL (Used for generating absolute QR code URLs)
# Development: http://localhost:5173
# Production: https://your-domain.vercel.app
VITE_APP_URL=http://localhost:5173

# Optional: External SMS / Telephony Gateway (Leave empty or "none" for MVP)
VITE_TELEPHONY_PROVIDER=none
